# Application
APP_NAME=Badminton Data Platform
ENVIRONMENT=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Database: PostgreSQL is required in deployment. SQLite is supported only for local tests.
DATABASE_URL=postgresql+psycopg://badminton:badminton@postgres:5432/badminton

# Source and cutover
BWF_LIVE_BASE_URL=https://extranet-lv.bwfbadminton.com
BWF_REQUEST_TIMEOUT_SECONDS=20
BWF_USER_AGENT=BadmintonDataPlatform/0.1 (permitted collection)
HISTORICAL_SEED_CUTOFF_DATE=2026-08-22
BWF_INGESTION_START_DATE=2026-08-23

# Adaptive polling
POLL_IDLE_MINUTES=30
POLL_TOURNAMENT_MINUTES=5
POLL_LIVE_MATCH_SECONDS=60
POLL_ERROR_BACKOFF_MAX_SECONDS=900

# Storage and retention
RAW_RETENTION_DAYS=30
SEED_DATASET_ROOT=/data/historical_dataset/bwf_match_data_2010_2026_08_22

# Public/admin protection
API_RATE_LIMIT_PER_MINUTE=120
ADMIN_API_KEY=replace-before-deployment

# Scheduler
SCHEDULER_ENABLED=false

# Authorized ranking and player-profile collection
BWF_RANKINGS_ENABLED=false
BWF_RANKINGS_ALLOW_LIVE_SOURCE=false
BWF_RANKINGS_PERMISSION_REQUIRED=true
BWF_RANKINGS_PERMISSION_REFERENCE=
BWF_RANKINGS_SCHEDULER_ENABLED=false
BWF_PLAYER_PROFILES_ENABLED=false
BWF_PLAYER_PROFILES_ALLOW_LIVE_SOURCE=false
BWF_PLAYER_PROFILES_PERMISSION_REQUIRED=true
BWF_PLAYER_PROFILES_PERMISSION_REFERENCE=
BWF_PLAYER_PROFILES_SCHEDULER_ENABLED=false
BWF_PLAYER_PROFILES_AUTO_CONFIRM=false
BWF_PLAYER_PROFILES_DRY_RUN=true

# Corporate calendar and direct draw PDF parsing
BWF_CALENDAR_ENABLED=false
BWF_CALENDAR_SCHEDULER_ENABLED=false
BWF_CALENDAR_PERMISSION_REQUIRED=true
BWF_CALENDAR_PERMISSION_REFERENCE=
BWF_DRAW_PARSER_ENABLED=false

# Evidence-gated model publication
MODELING_SCHEDULER_ENABLED=false
MODELING_REFRESH_HOURS=24
MODELING_MAX_FORECASTS_PER_RUN=5000
MODELING_SIMULATION_COUNT=1000
